<launch>
	<arg name="uav_id" default="1"/>
	<arg name="uav_name" default="uav"/>
    <arg name="flag_printf" default="true"/>
    <arg name="external_source" default="9"/>
    <arg name="t265_odom_topic" default="/camera/odom/sample"/>
	<arg name="server" default="192.168.5.11"/>
	<arg name="enable_rangeSensor" default="false"/>
    <!-- Rviz config -->
    <arg name="rviz_enable" default="false"/>

    <!-- 启动 vrpn_client_ros -->
    <include file="$(find sunray_uav_control)/launch/sunray_vrpn.launch" if="$(eval external_source == 0)">
        <arg name="server" value="$(arg server)"/>
        <arg name="uav_id" value="$(arg uav_id)"/>
    </include>

    <!-- 启动 vision_pose_node -->
    <node pkg="sunray_uav_control" type="vision_pose_node" name="vision_pose_node_$(arg uav_id)" output="screen">
        <remap from="/tf" to="/$(arg uav_name)$(arg uav_id)/tf"/>
        <remap from="/tf_static" to="/$(arg uav_name)$(arg uav_id)/tf_static"/>
        <param name="flag_printf" value="$(arg flag_printf)" />
        <param name="uav_id" value="$(arg uav_id)" />
        <param name="uav_name" value="$(arg uav_name)" />
        <param name="external_source" value="$(arg external_source)" />
        <param name="t265_odom_topic" value="$(arg t265_odom_topic)" />
        <param name="enable_rangeSensor" value="$(arg enable_rangeSensor)" />
        <param name="enable_rviz" value="$(arg rviz_enable)" />
    </node>

    <arg name="rivz_config" default="$(find sunray_uav_control)/rviz/uav.rviz"/>
	<!-- 启动Rviz-->
	<group if="$(arg rviz_enable)">
        <node type="rviz" name="rviz" pkg="rviz" args="-d $(arg rivz_config)"/>
    </group>
</launch>