#!/usr/bin/env python3

import rospy

from std_msgs.msg import String
from mavros_msgs.msg import PositionTarget
from quadrotor_msgs.msg import PositionCommand


class EgoTrajectoryBridge:

    def __init__(self):

        self.input_topic = rospy.get_param(
            "~input_topic",
            "/position_cmd"
        )

        self.output_topic = rospy.get_param(
            "~output_topic",
            "/ego_uav_interface/ego_setpoint"
        )

        self.timeout = rospy.get_param(
            "~timeout",
            0.25
        )

        self.last_cmd_time = None
        self.last_traj_id = None

        self.output_pub = rospy.Publisher(
            self.output_topic,
            PositionTarget,
            queue_size=20
        )

        self.status_pub = rospy.Publisher(
            "/ego_uav_interface/ego_bridge_status",
            String,
            queue_size=1,
            latch=True
        )

        rospy.Subscriber(
            self.input_topic,
            PositionCommand,
            self.command_callback,
            queue_size=50
        )

        rospy.Timer(
            rospy.Duration(0.1),
            self.timer_callback
        )

        rospy.loginfo("======================================")
        rospy.loginfo(" EGO trajectory bridge")
        rospy.loginfo("--------------------------------------")
        rospy.loginfo(" Input  : %s", self.input_topic)
        rospy.loginfo(" Output : %s", self.output_topic)
        rospy.loginfo(" Mode   : POSITION + VELOCITY")
        rospy.loginfo(" Mask   : 3520")
        rospy.loginfo(" Acceleration ignored")
        rospy.loginfo(" Yaw/yaw-rate ignored")
        rospy.loginfo("======================================")


    def command_callback(self, msg):

        out = PositionTarget()

        out.header.stamp = rospy.Time.now()
        out.header.frame_id = "map"

        # ROS-side values are expressed in the local ENU convention.
        # MAVROS handles the conversion to MAVLink LOCAL_NED.
        out.coordinate_frame = PositionTarget.FRAME_LOCAL_NED

        # ============================================================
        # POSITION + VELOCITY experiment
        #
        # Enabled:
        #   position xyz
        #   velocity xyz
        #
        # Ignored:
        #   acceleration xyz
        #   yaw
        #   yaw_rate
        #
        # 64 + 128 + 256 + 1024 + 2048 = 3520
        # ============================================================

        # Position + velocity + acceleration enabled.
        # Yaw and yaw-rate remain isolated.
        out.type_mask = (
            PositionTarget.IGNORE_YAW |
            PositionTarget.IGNORE_YAW_RATE
        )

        # Position
        out.position.x = msg.position.x
        out.position.y = msg.position.y
        out.position.z = msg.position.z

        # Velocity
        out.velocity.x = msg.velocity.x
        out.velocity.y = msg.velocity.y
        out.velocity.z = msg.velocity.z

        # Keep copying these for diagnostics,
        # although PX4 ignores them according to type_mask.
        out.acceleration_or_force.x = msg.acceleration.x
        out.acceleration_or_force.y = msg.acceleration.y
        out.acceleration_or_force.z = msg.acceleration.z

        out.yaw = msg.yaw
        out.yaw_rate = msg.yaw_dot

        self.output_pub.publish(out)

        self.last_cmd_time = rospy.Time.now()
        self.last_traj_id = msg.trajectory_id

        self.status_pub.publish(
            String(
                data="ACTIVE traj_id={} mask={}".format(
                    self.last_traj_id,
                    out.type_mask
                )
            )
        )


    def timer_callback(self, event):

        if self.last_cmd_time is None:

            self.status_pub.publish(
                String(data="WAIT_POSITION_CMD")
            )
            return

        age = (
            rospy.Time.now() - self.last_cmd_time
        ).to_sec()

        if age > self.timeout:

            self.status_pub.publish(
                String(
                    data="STALE age={:.3f}".format(age)
                )
            )


if __name__ == "__main__":

    rospy.init_node("ego_trajectory_bridge")

    EgoTrajectoryBridge()

    rospy.spin()
