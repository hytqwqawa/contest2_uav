<launch>

    <arg name="show_rviz" default="true"/>

    <arg name="p1_x" default="2.5"/>
    <arg name="p1_y" default="-0.5"/>
    <arg name="p1_yaw_deg" default="90.0"/>

    <arg name="p2_x" default="-2.2"/>
    <arg name="p2_y" default="0.5"/>
    <arg name="p2_yaw_deg" default="180.0"/>

    <arg name="hover_time" default="3.0"/>

    <node
        pkg="ego_uav_interface"
        type="ego_backend_wrapper.sh"
        name="ego_backend_wrapper"
        output="log"
        required="true"
    />

    <node
        pkg="ego_uav_interface"
        type="rviz_goal_executor.py"
        name="rviz_goal_executor"
        output="log"
    />

    <node
        if="$(arg show_rviz)"
        pkg="ego_uav_interface"
        type="rviz_field_visualizer.py"
        name="rviz_field_visualizer"
        output="log"
    />

    <node
        if="$(arg show_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find ego_uav_interface)/config/uav1_ego.rviz"
        output="log"
    />

    <node
        pkg="ego_uav_interface"
        type="auto_course_mission.py"
        name="auto_course_mission"
        output="screen"
        required="false">

        <param name="p1_x" value="$(arg p1_x)"/>
        <param name="p1_y" value="$(arg p1_y)"/>
        <param name="p1_yaw_deg" value="$(arg p1_yaw_deg)"/>

        <param name="p2_x" value="$(arg p2_x)"/>
        <param name="p2_y" value="$(arg p2_y)"/>
        <param name="p2_yaw_deg" value="$(arg p2_yaw_deg)"/>

        <param name="hover_time" value="$(arg hover_time)"/>

        <param name="yaw_tolerance_deg" value="8.0"/>
        <param name="yaw_stable_time" value="0.8"/>
        <param name="yaw_timeout" value="15.0"/>

    </node>

</launch>
