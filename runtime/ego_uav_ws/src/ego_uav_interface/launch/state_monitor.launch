<launch>

  <node pkg="ego_uav_interface"
        type="state_monitor_node"
        name="state_monitor_node"
        output="screen">

    <param name="mocap_pose_topic"
           value="/vrpn_client_node_1/uav1/pose"/>

    <param name="px4_odom_topic"
           value="/uav1/mavros/local_position/odom"/>

    <!-- First conservative thresholds -->
    <param name="position_error_max"
           value="0.10"/>

    <param name="yaw_error_max_deg"
           value="5.0"/>

    <param name="message_timeout"
           value="0.15"/>

    <param name="stable_time"
           value="1.5"/>

  </node>

</launch>
