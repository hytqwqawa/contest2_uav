#!/usr/bin/env python3
"""Demo8 yaw and safety regression tests. No ROS imports, no flying."""
import copy
import math
from pathlib import Path
import tempfile
import yaml
from demo5_config import load_config
from demo8_terminal_yaw import TerminalYawGate, demo_yaw_to_world_deg, yaw_error_deg

BASE = Path(__file__).resolve().parent
cfg = load_config(BASE / 'demo5_waypoints.yaml')
assert cfg['waypoints'][0]['mode'] == 'POINT'
assert cfg['waypoints'][1]['yaw_deg'] == 0.0
assert 'yaw_deg' not in cfg['waypoints'][2]


def test_bad(patch):
    data = copy.deepcopy(cfg)
    patch(data)
    with tempfile.TemporaryDirectory() as td:
        f = Path(td) / 'c.yaml'
        f.write_text(yaml.safe_dump(data))
        try:
            load_config(f)
        except (ValueError, KeyError, TypeError):
            return
        raise AssertionError('unsafe yaml accepted: %s' % data)


test_bad(lambda c: c['waypoints'][0].update(yaw_deg=20))  # POINT forbidden
test_bad(lambda c: c['waypoints'][1].update(yaw_deg=float('nan')))
test_bad(lambda c: c['waypoints'][1].update(yaw_deg=181))
test_bad(lambda c: c['waypoints'][1].update(yaw_deg='90'))
test_bad(lambda c: c['waypoints'][1].update(yaw_deg=True))
test_bad(lambda c: c['waypoints'][1].update(unrecognized=42))
assert abs(demo_yaw_to_world_deg((1, 0), 90) - 90) < 1e-9
assert abs(demo_yaw_to_world_deg((0, 1), -90)) < 1e-9
assert abs(demo_yaw_to_world_deg((0, 1), 0) - 90) < 1e-9
assert yaw_error_deg(math.radians(-179), 179) < 2.001

gate = TerminalYawGate((3., .5, .8), 90, stable_s=1.0)
good = ((3., .5, .8), (0.0, 0.0, 0.0), math.radians(92))
assert gate.update(0.0, *good, setpoint_ok=True)[0] is False
assert gate.update(0.9, *good, setpoint_ok=True)[0] is False
assert gate.update(1.0, *good, setpoint_ok=True)[0] is True
assert gate.update(1.1, *good, setpoint_ok=False)[0] is False
assert gate.update(2.0, *good, setpoint_ok=True)[0] is False
assert gate.update(2.5, *good, setpoint_ok=True)[0] is False
assert gate.update(3.1, *good, setpoint_ok=True)[0] is True
assert gate.update(3.2, (3.3, .5, .8), (0,0,0), math.radians(90), True)[0] is False
assert gate.update(3.3, (3.,.5,.8), (.3,0,0), math.radians(90), True)[0] is False
assert gate.update(3.4, (3.,.5,.8), (0,0,0), math.radians(60), True)[0] is False
print('[ OK ] Demo8: EGO-only yaw configuration, frame conversion, wrap/limits, stable gate')
