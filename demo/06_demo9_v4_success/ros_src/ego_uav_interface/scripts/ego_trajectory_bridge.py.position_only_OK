#!/usr/bin/env python3

import rospy

from quadrotor_msgs.msg import PositionCommand
from mavros_msgs.msg import PositionTarget
from std_msgs.msg import String


class EgoTrajectoryBridge:

    def __init__(self):

        self.input_topic = rospy.get_param(
            "~input_topic",
            "/position_cmd"
        )

        self.output_topic = rospy.get_param(
            "~output_topic",
            "/ego_uav_interface/trajectory_setpoint"
        )

        self.command_timeout = rospy.get_param(
            "~command_timeout",
            0.20
        )

        self.last_cmd_time = None
        self.last_trajectory_id = None
        self.forwarding = False

        self.output_pub = rospy.Publisher(
            self.output_topic,
            PositionTarget,
            queue_size=20
        )

        self.status_pub = rospy.Publisher(
            "/ego_uav_interface/ego_bridge_status",
            String,
            queue_size=1,
            latch=True
        )

        self.cmd_sub = rospy.Subscriber(
            self.input_topic,
            PositionCommand,
            self.command_callback,
            queue_size=20
        )

        self.timer = rospy.Timer(
            rospy.Duration(0.05),
            self.timer_callback
        )

        rospy.loginfo("======================================")
        rospy.loginfo(" EGO trajectory bridge")
        rospy.loginfo("--------------------------------------")
        rospy.loginfo(" Input  : %s", self.input_topic)
        rospy.loginfo(" Output : %s", self.output_topic)
        rospy.loginfo(" Timeout: %.2f s", self.command_timeout)
        rospy.loginfo("--------------------------------------")
        rospy.loginfo(" Mapping:")
        rospy.loginfo(" position     -> position")
        rospy.loginfo(" velocity     -> velocity")
        rospy.loginfo(" acceleration -> acceleration")
        rospy.loginfo(" yaw          -> yaw")
        rospy.loginfo(" yaw_dot      -> yaw_rate")
        rospy.loginfo(" jerk         -> ignored by PX4 interface")
        rospy.loginfo("======================================")

    def command_callback(self, msg):

        self.last_cmd_time = rospy.Time.now()

        if msg.trajectory_flag != PositionCommand.TRAJECTORY_STATUS_READY:

            self.forwarding = False

            self.status_pub.publish(
                String(
                    data="EGO_TRAJECTORY_NOT_READY:"
                         + str(msg.trajectory_flag)
                )
            )

            rospy.logwarn_throttle(
                1.0,
                "[EGO BRIDGE] trajectory_flag=%d, not forwarding",
                msg.trajectory_flag
            )

            return

        if self.last_trajectory_id != msg.trajectory_id:

            self.last_trajectory_id = msg.trajectory_id

            rospy.logwarn(
                "[EGO BRIDGE] New trajectory_id=%d",
                msg.trajectory_id
            )

        out = PositionTarget()

        out.header.stamp = rospy.Time.now()
        out.header.frame_id = (
            msg.header.frame_id
            if msg.header.frame_id
            else "map"
        )

        # Values are supplied in ROS local coordinates.
        # MAVROS performs the MAVLink frame conversion.
        out.coordinate_frame = PositionTarget.FRAME_LOCAL_NED

        # Use:
        # position + velocity + acceleration + yaw + yaw_rate
        # Initial real-flight validation:
        # execute the continuous EGO position trajectory only.
        # Velocity/acceleration/yaw/yaw-rate are temporarily ignored
        # to isolate the PX4 execution layer.
        out.type_mask = (
            PositionTarget.IGNORE_VX |
            PositionTarget.IGNORE_VY |
            PositionTarget.IGNORE_VZ |
            PositionTarget.IGNORE_AFX |
            PositionTarget.IGNORE_AFY |
            PositionTarget.IGNORE_AFZ |
            PositionTarget.IGNORE_YAW |
            PositionTarget.IGNORE_YAW_RATE
        )

        out.position.x = msg.position.x
        out.position.y = msg.position.y
        out.position.z = msg.position.z

        out.velocity.x = msg.velocity.x
        out.velocity.y = msg.velocity.y
        out.velocity.z = msg.velocity.z

        out.acceleration_or_force.x = msg.acceleration.x
        out.acceleration_or_force.y = msg.acceleration.y
        out.acceleration_or_force.z = msg.acceleration.z

        out.yaw = msg.yaw
        out.yaw_rate = msg.yaw_dot

        self.output_pub.publish(out)

        self.forwarding = True

        self.status_pub.publish(
            String(
                data="EGO_TRAJECTORY_FORWARDING"
            )
        )

    def timer_callback(self, event):

        if self.last_cmd_time is None:

            self.status_pub.publish(
                String(data="WAIT_EGO_POSITION_CMD")
            )

            return

        age = (
            rospy.Time.now() - self.last_cmd_time
        ).to_sec()

        if age > self.command_timeout:

            if self.forwarding:

                rospy.logwarn(
                    "[EGO BRIDGE] PositionCommand timeout "
                    "(%.3f s)",
                    age
                )

            self.forwarding = False

            self.status_pub.publish(
                String(data="EGO_POSITION_CMD_TIMEOUT")
            )


if __name__ == "__main__":

    rospy.init_node("ego_trajectory_bridge")

    EgoTrajectoryBridge()

    rospy.spin()
