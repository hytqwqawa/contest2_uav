<launch>
  <!-- POINT controls physical takeoff and straight POINT waypoints. -->
  <node pkg="ego_uav_interface" type="point_traj_node.py"
        name="point_traj_node" output="log">
    <param name="output_topic" value="/contest2/ego_uav_interface/point_setpoint"/>
    <param name="max_speed" value="0.15"/>
    <param name="takeoff_height" value="0.80"/>
    <param name="takeoff_speed" value="0.40"/>
    <param name="takeoff_acc" value="0.80"/>
    <remap from="/contest2/move_base_simple/goal"
           to="/contest2/ego_uav_interface/point_goal"/>
  </node>

  <!-- Single authoritative POINT/EGO selector and continuity checking. -->
  <node pkg="ego_uav_interface" type="trajectory_mux_v4_only.py"
        name="trajectory_mux" output="log"/>

  <!-- This bridge consumes EGO's B-spline trajectory-server output. -->
  <node pkg="ego_uav_interface" type="ego_trajectory_bridge.py"
        name="ego_trajectory_bridge" output="screen">
    <param name="yaw_rate_limit" value="0.80"/>
    <param name="max_yaw_lead" value="0.30"/>
    <param name="min_tangent_speed" value="0.06"/>
  </node>
</launch>
