<launch>

  <!-- ====================================================== -->
  <!-- POINT takeoff / landing                               -->
  <!-- ====================================================== -->

  <node pkg="ego_uav_interface"
        type="point_traj_node.py"
        name="point_traj_node"
        output="log">

    <param name="output_topic"
           value="/contest2/ego_uav_interface/point_setpoint" />

    <param name="takeoff_height" value="0.80" />
    <param name="takeoff_speed"  value="0.20" />
    <param name="takeoff_acc"    value="0.40" />

    <!-- Proven V4 landing -->
    <param name="land_speed" value="0.30" />
    <param name="land_acc" value="0.60" />

    <param name="land_target_offset"
           value="-0.10" />

    <param name="land_terminal_range"
           value="0.10" />

    <param name="land_terminal_speed"
           value="0.30" />

    <param name="land_terminal_min_offset"
           value="-0.20" />

    <param name="land_terminal_fault_grace"
           value="0.60" />

    <param name="range_timeout"
           value="0.30" />

    <!-- Keep RViz/EGO goals isolated from POINT -->
    <remap from="/contest2/move_base_simple/goal"
           to="/contest2/ego_uav_interface/point_goal" />

  </node>


  <!-- ====================================================== -->
  <!-- Trajectory mux                                        -->
  <!-- ====================================================== -->

  <node pkg="ego_uav_interface"
        type="trajectory_mux.py"
        name="trajectory_mux"
        output="log" />


  <!-- ====================================================== -->
  <!-- Proven touchdown configuration                         -->
  <!-- ====================================================== -->

  <param name="/contest2/uav2_touchdown/range_threshold"
         value="0.08" />

  <param name="/contest2/uav2_touchdown/range_timeout"
         value="0.30" />

  <param name="/contest2/uav2_touchdown/stable_time"
         value="0.20" />

  <param name="/contest2/uav2_touchdown/min_drop"
         value="0.30" />


  <!-- ====================================================== -->
  <!-- EGO -> interface bridge                               -->
  <!-- ====================================================== -->

  <node pkg="ego_uav_interface"
        type="ego_trajectory_bridge.py"
        name="ego_trajectory_bridge"
        output="screen" />

</launch>
