<launch>

  <!--
    Demo3 minimal flight backend.

    Core already owns:
      MAVROS
      state/preflight/RC monitors
      offboard_manager
      trajectory_interface
      T265 -> PX4 external vision

    Demo3 only needs:
      POINT trajectory source
      POINT/EGO mux (POINT selected)
  -->

  <node pkg="ego_uav_interface"
        type="point_traj_node.py"
        name="point_traj_node"
        output="log">

    <param name="output_topic"
           value="/contest2/ego_uav_interface/point_setpoint" />

    <!-- Same accepted takeoff profile as Demo1 / Demo2 -->
    <param name="takeoff_height" value="0.80" />
    <param name="takeoff_speed"  value="0.20" />
    <param name="takeoff_acc"    value="0.40" />

    <!-- Same accepted landing trajectory -->
    <param name="land_speed" value="0.30" />
    <param name="land_acc"   value="0.60" />

    <param name="land_target_offset"
           value="-0.10" />

    <!-- Enter terminal descent at 10 cm range. -->
    <param name="land_terminal_range"
           value="0.10" />

    <param name="land_terminal_speed"
           value="0.30" />

    <param name="land_terminal_min_offset"
           value="-0.20" />

    <param name="land_terminal_fault_grace"
           value="0.60" />

    <param name="range_timeout"
           value="0.30" />

    <remap from="/contest2/move_base_simple/goal"
           to="/contest2/ego_uav_interface/point_goal" />

  </node>


  <node pkg="ego_uav_interface"
        type="trajectory_mux.py"
        name="trajectory_mux"
        output="log" />


  <!--
    Touchdown safety gate.
    STRICT 0.08 m threshold is intentionally unchanged.
  -->

  <param name="/contest2/uav2_touchdown/range_threshold"
         value="0.08" />

  <!-- This is a control handoff point, NOT a touchdown
       threshold. The strict touchdown threshold stays 0.08 m. -->
  <param name="/contest2/uav2_touchdown/autoland_handoff_range"
         value="0.17" />

  <param name="/contest2/uav2_touchdown/range_timeout"
         value="0.30" />

  <param name="/contest2/uav2_touchdown/stable_time"
         value="0.00" />

  <param name="/contest2/uav2_touchdown/min_drop"
         value="0.30" />

  <param name="/contest2/uav2_touchdown/ground_margin"
         value="0.03" />

  <param name="/contest2/uav2_touchdown/vz_max"
         value="0.10" />

</launch>
